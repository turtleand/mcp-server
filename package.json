{
  "name": "@turtleand/mcp-server",
  "version": "0.1.0",
  "type": "module",
  "description": "MCP server for Turtleand knowledge base",
  "bin": {
    "mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && cp src/content-index.json dist/",
    "build-index": "node --import tsx scripts/build-index.ts",
    "start": "node dist/index.js",
    "test:index": "node --import tsx --test tests/content-index.test.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.4.0"
  }
}
